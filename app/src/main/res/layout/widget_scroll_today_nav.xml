<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.39 可滚动 Today + 日期导航: 复制 widget_scroll_today 结构(壳图+条带 ListView),
     顶部再叠 ‹ / 回今天 / › 透明按钮(在 ListView 之上, 仅拦截顶部 48dp 触摸, 下方仍可滚动)。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_scroll_clip"
    android:outlineProvider="background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="false" />

    <ListView
        android:id="@+id/widget_strip_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:cacheColorHint="@android:color/transparent"
        android:listSelector="@android:color/transparent" />

    <ImageView
        android:id="@+id/today_btn_prev"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_gravity="top|left"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/today_btn_today"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="56dp"
        android:layout_marginRight="56dp"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/today_btn_next"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_gravity="top|right"
        android:importantForAccessibility="no" />
</FrameLayout>
